<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:SCSKiller.Ui"
             xmlns:c="using:SCSKiller.Ui.Controls"
             xmlns:m="using:SCSKiller.Ui.Models"
             x:Class="SCSKiller.Ui.Pages.SettingsPage"
             x:DataType="m:SettingsVm">

    <UserControl.Styles>
        <Style Selector="ToggleSwitch">
            <Setter Property="OnContent" Value="{x:Null}" />
            <Setter Property="OffContent" Value="{x:Null}" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="VerticalAlignment" Value="Top" />
        </Style>
        <Style Selector="Rectangle.Divider">
            <Setter Property="Height" Value="1" />
            <Setter Property="Fill" Value="{DynamicResource CardStrokeColorDefaultBrush}" />
        </Style>
        <!-- WinUI's RadioButtons with two-line choices: 15 px more per row, 6 above and 8 below the group (measured on its shots) -->
        <Style Selector="StackPanel.Radios">
            <Setter Property="Margin" Value="0,6,0,8" />
        </Style>
        <Style Selector="StackPanel.Radios > RadioButton">
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Margin" Value="0,7,0,8" />
        </Style>
        <Style Selector="StackPanel.Radios > RadioButton TextBlock">
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <!-- a text and its button: the button goes under the text when the cards stack -->
        <Style Selector="Grid.Split > :is(Control).Side">
            <Setter Property="Grid.Column" Value="1" />
        </Style>
        <Style Selector=".Narrow Grid.Split > :is(Control).Side">
            <Setter Property="Grid.Column" Value="0" />
            <Setter Property="Grid.Row" Value="1" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="Margin" Value="0,8,0,0" />
        </Style>
        <!-- WinUI's ComboBox Header -->
        <Style Selector="TextBlock.Header">
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </UserControl.Styles>

    <ScrollViewer x:Name="Scroller">
        <StackPanel Margin="36,28,36,28" Spacing="16">
            <TextBlock Text="设置" Classes="Title" />

            <Border Classes="Card" Padding="20">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="4">
                        <TextBlock Text="{Binding CacheTitle}" Classes="Section" />
                        <TextBlock Text="{Binding CacheIntro}" Classes="Secondary" TextWrapping="Wrap" />
                    </StackPanel>
                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="12">
                        <StackPanel Spacing="2">
                            <TextBlock Text="当前上限" Classes="Caption" />
                            <TextBlock Text="{Binding CurrentLimit}" Classes="Section" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock Text="当前已用" Classes="Caption" />
                            <TextBlock Text="{Binding Used}" Classes="Section" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock Text="{Binding FreeLabel}" Classes="Caption" />
                            <TextBlock Text="{Binding Free}" Classes="Section" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="14" IsVisible="{Binding Configurable, Mode=OneTime}">
                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="12">
                            <TextBlock x:Name="NewLimitLabel" Text="新上限" VerticalAlignment="Center" />
                            <ComboBox Grid.Column="1" ItemsSource="{x:Static m:SettingsVm.SizeLabels}" MinWidth="220"
                                      SelectedIndex="{Binding SizeIndex, Mode=TwoWay}" AutomationProperties.LabeledBy="{Binding #NewLimitLabel}" />
                            <Button Grid.Column="3" Classes="accent" Click="OnApply" AutomationProperties.Name="应用（需要管理员）" IsEnabled="{Binding CanApplyLimit}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="Icon" Text="{x:Static ui:Glyphs.Shield}" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="应用（需要管理员）" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <c:InfoBar IsVisible="{Binding HasApplyMessage}" Message="{Binding ApplyMessage}" Severity="{Binding ApplySeverity}" IsClosable="False" />
                        <TextBlock Text="随时可以在这里改回驱动默认值。" Classes="Caption" />
                    </StackPanel>
                    <StackPanel Spacing="6" IsVisible="{Binding HasAmdUse}">
                        <TextBlock Text="{Binding AmdUse}" TextWrapping="Wrap" />
                        <ProgressBar Value="{Binding AmdPercent}" AutomationProperties.Name="AMD DirectX 12 缓存占用" />
                    </StackPanel>
                    <c:InfoBar IsVisible="{Binding NotConfigurable, Mode=OneTime}" Severity="Informational" IsClosable="False" Message="{Binding NotConfigurableText}" />
                    <c:InfoBar IsVisible="{Binding HasAmdAlwaysOn}" Severity="Warning" IsClosable="False" Message="{Binding AmdAlwaysOn}" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12" IsVisible="{Binding IsAmd, Mode=OneTime}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="另行保留已编译缓存" Classes="BodyStrong" />
                            <TextBlock Text="在驱动移除游戏的已编译缓存后将其放回。" Classes="Secondary" TextWrapping="Wrap" />
                            <WrapPanel ItemSpacing="12" Margin="0,4,0,0" IsVisible="{Binding HasKept}">
                                <TextBlock Text="{Binding KeptSummary}" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <Button Content="管理…" Click="OnManageKept" />
                            </WrapPanel>
                        </StackPanel>
                        <ToggleSwitch Grid.Column="1" IsChecked="{Binding KeepCachesAside, Mode=TwoWay}" AutomationProperties.Name="另行保留已编译缓存" />
                    </Grid>
                    <StackPanel Spacing="8" IsVisible="{Binding ShowsShaderCleanup, Mode=OneTime}">
                        <Grid Classes="Split" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="2" VerticalAlignment="Center">
                                <TextBlock Text="Windows 自动磁盘清理" Classes="BodyStrong" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ShaderCleanupLine}" Classes="Secondary" TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Classes="Side" Click="OnShaderCleanup" VerticalAlignment="Center" AutomationProperties.Name="{Binding ShaderCleanupAction}" IsEnabled="{Binding CanApplyShaderCleanup}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="Icon" Text="{x:Static ui:Glyphs.Shield}" FontSize="14" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding ShaderCleanupAction}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                        <c:InfoBar IsVisible="{Binding HasShaderCleanupMessage}" Message="{Binding ShaderCleanupMessage}" Severity="{Binding ShaderCleanupSeverity}" IsClosable="False" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Grid x:Name="Cards" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">

                <Border Classes="Card" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="驱动更新后" Classes="Section" />
                        <TextBlock Text="新驱动会丢弃所有已编译的着色器，已编译的游戏会再次卡顿，直到重新编译完成。"
                                   Classes="Secondary" TextWrapping="Wrap" />
                        <StackPanel Classes="Radios" AutomationProperties.Name="何时重新编译" IsVisible="{Binding ShowsDriverModes, Mode=OneTime}">
                            <RadioButton GroupName="DriverMode" AutomationProperties.Name="每次询问"
                                         IsChecked="{Binding DriverMode, Converter={x:Static ui:Converters.Index}, ConverterParameter=0}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="每次询问" />
                                    <TextBlock Text="{x:Static m:SettingsVm.AskNote}" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="DriverMode" AutomationProperties.Name="自动，仅在电脑空闲时"
                                         IsChecked="{Binding DriverMode, Converter={x:Static ui:Converters.Index}, ConverterParameter=1}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="自动，仅在电脑空闲时" />
                                    <TextBlock Text="{x:Static m:SettingsVm.WhenIdleNote}" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="DriverMode" AutomationProperties.Name="自动，立即开始"
                                         IsChecked="{Binding DriverMode, Converter={x:Static ui:Converters.Index}, ConverterParameter=2}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="自动，立即开始" />
                                    <TextBlock Text="立刻开始，游戏运行时暂停。" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="DriverMode" AutomationProperties.Name="关闭"
                                         IsChecked="{Binding DriverMode, Converter={x:Static ui:Converters.Index}, ConverterParameter=3}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="关闭" />
                                    <TextBlock Text="自己从游戏库重新编译游戏。" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <TextBlock Text="{Binding DriverModesNote, Mode=OneTime}" IsVisible="{Binding HasDriverModesNote, Mode=OneTime}" TextWrapping="Wrap" />
                        <c:InfoBar IsVisible="{Binding HasDriverModeMessage}" Message="{Binding DriverModeMessage}" Severity="Error" IsClosable="False" />
                        <TextBlock Text="{Binding LastRebuilt}" Classes="Caption" IsVisible="{Binding HasLastRebuilt}" />
                        <Rectangle Classes="Divider" />
                        <TextBlock x:Name="NewShadersHeader" Text="当游戏有新着色器时" Classes="Section" />
                        <TextBlock Text="已编译的游戏会通过录制、共享着色器哈希或 SCSKiller 更新获得新管线。绝不会在你游戏时进行。"
                                   Classes="Secondary" TextWrapping="Wrap" />
                        <StackPanel Classes="Radios" AutomationProperties.Name="当游戏有新着色器时">
                            <RadioButton GroupName="NewShaders" AutomationProperties.Name="关闭"
                                         IsChecked="{Binding NewShadersChoice, Converter={x:Static ui:Converters.Index}, ConverterParameter=0}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="关闭" />
                                    <TextBlock Text="自己从游戏库编译游戏。" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="NewShaders" AutomationProperties.Name="通知我"
                                         IsChecked="{Binding NewShadersChoice, Converter={x:Static ui:Converters.Index}, ConverterParameter=1}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="通知我" />
                                    <TextBlock Text="弹出通知并提供“立即编译”。不会自动开始任何操作。" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="NewShaders" AutomationProperties.Name="自动编译并通知我"
                                         IsChecked="{Binding NewShadersChoice, Converter={x:Static ui:Converters.Index}, ConverterParameter=2}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="自动编译并通知我" />
                                    <TextBlock Text="在电脑空闲时编译，并告知你已加入队列。" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton GroupName="NewShaders" AutomationProperties.Name="自动静默编译"
                                         IsChecked="{Binding NewShadersChoice, Converter={x:Static ui:Converters.Index}, ConverterParameter=3}">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="自动静默编译" />
                                    <TextBlock Text="在电脑空闲时编译，不弹通知。" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                        <CheckBox IsChecked="{Binding NewShadersRightAway, Mode=TwoWay}" AutomationProperties.Name="立即编译新着色器">
                            <StackPanel Spacing="2">
                                <TextBlock Text="立即编译新着色器" TextWrapping="Wrap" />
                                <TextBlock Text="自动编译在游戏退出时开始，而不是等电脑空闲。"
                                           Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding CompileNewGames, Mode=TwoWay}" AutomationProperties.Name="自动编译新游戏">
                            <StackPanel Spacing="2">
                                <TextBlock Text="自动编译新游戏" TextWrapping="Wrap" />
                                <TextBlock Text="从未编译过的游戏会在电脑空闲时编译，与“添加全部就绪”的效果相同。"
                                           Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <Rectangle Classes="Divider" />
                        <CheckBox Content="运行其他游戏时暂停后台编译" IsChecked="{Binding PauseWhileGaming, Mode=TwoWay}" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock Text="后台重新编译的线程数" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="1" Text="{Binding BackgroundThreadsText}" />
                        </Grid>
                        <Slider Minimum="1" Maximum="{Binding MaxThreads, Mode=OneTime}" TickFrequency="1" IsSnapToTickEnabled="True"
                                Value="{Binding BackgroundThreads, Mode=TwoWay}" AutomationProperties.Name="后台重新编译的线程数" />
                        <StackPanel Spacing="12" IsVisible="{Binding ShowsAutoShader, Mode=OneTime}">
                            <StackPanel Spacing="8">
                                <CheckBox x:Name="AutoBox" Content="Auto Shader Compilation（NVIDIA 测试版）" IsChecked="{Binding AutoOn, Mode=TwoWay}" />
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                    <StackPanel>
                                        <TextBlock Text="系统占用率" Classes="Header" />
                                        <ComboBox ItemsSource="{x:Static m:SettingsVm.AutoLevels}" SelectedIndex="{Binding AutoLevelIndex, Mode=TwoWay}"
                                                  IsEnabled="{Binding #AutoBox.IsChecked}" MinWidth="140" AutomationProperties.Name="系统占用率" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Click="OnApplyAuto" VerticalAlignment="Bottom" AutomationProperties.Name="应用（需要管理员）" IsEnabled="{Binding CanApplyAuto}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Classes="Icon" Text="{x:Static ui:Glyphs.Shield}" FontSize="14" VerticalAlignment="Center" />
                                            <TextBlock Text="应用（需要管理员）" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                                <TextBlock Text="{Binding AutoShaderText}" Classes="Caption" TextWrapping="Wrap" />
                                <c:InfoBar IsVisible="{Binding HasAutoMessage}" Message="{Binding AutoMessage}" Severity="{Binding AutoSeverity}" IsClosable="False" />
                            </StackPanel>
                            <c:InfoBar Severity="Informational" IsClosable="False" Title="建议开启"
                                       Message="NVIDIA App 的测试版功能：驱动更新后它会重新编译你玩过的游戏。SCSKiller 负责其余全部，两者一起用效果最好。重叠部分的代价很小：NVIDIA 已重建的着色器在这里每条约 1 ms。" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="12">

                    <Border x:Name="PatreonCard" Classes="Card" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="Patreon 与社区数据库" Classes="Section" />
                            <!-- the account's part: its DataContext is the page's AccountVm -->
                            <StackPanel x:Name="AccountPart" x:DataType="m:AccountVm" Spacing="12">
                                <StackPanel Spacing="12" IsVisible="{Binding SignedOut}">
                                    <TextBlock Text="Patreon 支持者可使用社区着色器哈希数据库以及 beta 和 alpha 版本。请使用你支持 SCSKiller 的 Patreon 账号登录。"
                                               Classes="Secondary" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button Classes="accent" Content="使用 Patreon 登录" Click="OnSignIn" IsEnabled="{Binding Idle}" />
                                        <Button Content="取消" Click="OnCancelSignIn" IsVisible="{Binding SigningIn}" />
                                    </StackPanel>
                                    <TextBlock Text="在浏览器中完成登录，这里无需其他操作。" Classes="Caption" TextWrapping="Wrap"
                                               IsVisible="{Binding SigningIn}" />
                                </StackPanel>
                                <StackPanel Spacing="12" IsVisible="{Binding SignedIn}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="已使用 Patreon 登录" />
                                        <TextBlock Text="{Binding Benefits}" Classes="Caption" TextWrapping="Wrap" />
                                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding NotMember}">
                                            <TextBlock Text="{Binding JoinLine}" Classes="Caption" VerticalAlignment="Center" />
                                            <HyperlinkButton Content="{Binding JoinLink}" Classes="Link" NavigateUri="https://www.patreon.com/SCSKiller" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button Content="刷新状态" Click="OnRefreshAccount" IsEnabled="{Binding Idle}" />
                                        <Button Content="退出登录" Click="OnSignOut" IsEnabled="{Binding CanSignOut}" />
                                        <c:ProgressRing IsActive="{Binding Busy}" IsVisible="{Binding Busy}" Width="16" Height="16" />
                                    </StackPanel>
                                    <c:InfoBar IsVisible="{Binding OffersSharing}" Severity="Success" IsClosable="False"
                                               Title="已加入。想帮助改进社区着色器哈希数据库吗？"
                                               Message="你的游戏着色器哈希将匿名共享，绝不会关联到你的 Patreon 账号。">
                                        <c:InfoBar.ActionButton>
                                            <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Left">
                                                <Button Classes="accent" Content="匿名共享" Click="OnShare" />
                                                <Button Content="暂不" Click="OnNotNow" />
                                            </StackPanel>
                                        </c:InfoBar.ActionButton>
                                    </c:InfoBar>
                                </StackPanel>
                                <c:InfoBar IsVisible="{Binding HasProblem}" Message="{Binding Problem}" Severity="Warning" IsClosable="False" />
                                <StackPanel Spacing="8" IsVisible="{Binding ShowsUpdates}">
                                    <Rectangle Classes="Divider" />
                                    <StackPanel IsVisible="{Binding ShowsChannels}">
                                        <TextBlock Text="更新通道" Classes="Header" />
                                        <ComboBox x:Name="ChannelBox" ItemsSource="{Binding ChannelLabels}" SelectedIndex="{Binding ChannelIndex, Mode=OneWay}" SelectionChanged="OnChannelPicked"
                                                  IsEnabled="{Binding CanPickChannel}" MinWidth="260" AutomationProperties.Name="更新通道" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ChannelNote}" Classes="Caption" TextWrapping="Wrap" />
                                    <Button Content="立即切回稳定版" Click="OnBackToStable" IsEnabled="{Binding CanPickChannel}" IsVisible="{Binding OffersBackToStable}" />
                                    <c:InfoBar IsVisible="{Binding HasUpdateProblem}" Message="{Binding UpdateProblem}" Severity="Warning" IsClosable="False" />
                                </StackPanel>
                                <Rectangle Classes="Divider" />
                                <StackPanel Spacing="4">
                                    <CheckBox IsChecked="{Binding UseCommunityDb, Mode=TwoWay}" IsEnabled="{Binding HasDb}" AutomationProperties.Name="下载共享着色器哈希">
                                        <StackPanel Spacing="2">
                                            <TextBlock Text="下载共享着色器哈希" TextWrapping="Wrap" />
                                            <TextBlock Text="用其他玩家录制的哈希编译你的游戏。" Classes="Caption" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                    <TextBlock Text="{Binding DbNote}" IsVisible="{Binding HasDbNote}" Classes="Caption" TextWrapping="Wrap" Margin="28,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                            <CheckBox IsChecked="{Binding ShareDiagnostics, Mode=TwoWay}" AutomationProperties.Name="共享诊断信息以帮助修复问题">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="共享诊断信息以帮助修复问题" TextWrapping="Wrap" />
                                    <TextBlock Text="编译失败时发送其错误代码，每次编译一次。" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding ShareRecordings, Mode=TwoWay}" AutomationProperties.Name="匿名共享着色器哈希">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="匿名共享着色器哈希" TextWrapping="Wrap" />
                                    <TextBlock Text="共享你录制的哈希、GPU 型号和驱动版本。绝不关联你的账号。" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <HyperlinkButton Content="共享了什么" NavigateUri="https://scskiller.com/privacy" Padding="0" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Classes="Card" Padding="20">
                        <StackPanel Spacing="12">
                            <TextBlock Text="运行队列时的编译速度" Classes="Section" />
                            <StackPanel Spacing="4" IsVisible="{Binding HasGpuChoices, Mode=OneTime}">
                                <TextBlock Text="编译使用的 GPU" Classes="Header" />
                                <ComboBox ItemsSource="{Binding GpuLabels, Mode=OneTime}" SelectedIndex="{Binding GpuIndex, Mode=TwoWay}"
                                          MinWidth="220" AutomationProperties.Name="编译使用的 GPU" />
                                <TextBlock Text="选择你的游戏运行的 GPU。SCSKiller 将在重启后切换。"
                                           Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                            <CheckBox IsChecked="{Binding ExperimentalIntel, Mode=TwoWay}" IsVisible="{Binding HasIntelGpu, Mode=OneTime}"
                                      AutomationProperties.Name="实验性：在 Intel GPU 上编译">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="实验性：在 Intel GPU 上编译" TextWrapping="Wrap" />
                                    <TextBlock Text="仅在 Intel Arc 上测量过。重启后生效。" Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="编译线程数" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Text="{Binding ThreadsText}" />
                            </Grid>
                            <Slider Minimum="1" Maximum="{Binding MaxThreads, Mode=OneTime}" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding Threads, Mode=TwoWay}" AutomationProperties.Name="编译线程数" />
                            <TextBlock Text="{Binding PriorityNote}" Classes="Caption" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock Text="编译最大内存" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Text="{Binding MaxCompileMemoryText}" />
                            </Grid>
                            <Slider Minimum="0" Maximum="{Binding MaxCompileMemoryMax, Mode=OneTime}" TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding MaxCompileMemory, Mode=TwoWay}" AutomationProperties.Name="编译最大内存（0 = 自动）" />
                            <TextBlock Text="{Binding MaxCompileMemoryNote, Mode=OneTime}" TextWrapping="Wrap" Classes="Caption" />
                            <Rectangle Classes="Divider" />
                            <CheckBox IsChecked="{Binding MaximumPlans, Mode=TwoWay}" AutomationProperties.Name="最大模式：同时编译每种着色器组合">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="最大模式：同时编译每种着色器组合" TextWrapping="Wrap" />
                                    <TextBlock Text="对 AMD 似乎最有帮助。编译耗时更长，占用磁盘更多。"
                                               Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <CheckBox IsChecked="{Binding CompileRayTracing, Mode=TwoWay}" AutomationProperties.Name="编译光线追踪着色器">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="编译光线追踪着色器" TextWrapping="Wrap" />
                                    <TextBlock Text="关闭时跳过：在游戏中开启光追后由游戏自行构建。"
                                               Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Classes="Card" Padding="20">
                    <StackPanel Spacing="12">
                        <TextBlock Text="通用" Classes="Section" />
                        <CheckBox IsChecked="{Binding StartWithWindows, Mode=TwoWay}" IsVisible="{Binding ShowsStartAtSignIn, Mode=OneTime}"
                                  IsEnabled="{Binding CanChangeStart, Mode=OneTime}" AutomationProperties.Name="{x:Static m:SettingsVm.StartText}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="{x:Static m:SettingsVm.StartText}" TextWrapping="Wrap" />
                                <TextBlock Text="{x:Static m:SettingsVm.StartNote}" Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <c:InfoBar IsVisible="{Binding HasStartMessage}" Message="{Binding StartMessage}" Severity="Informational" IsClosable="False" />
                        <CheckBox IsChecked="{Binding CloseQuits, Mode=TwoWay}" IsVisible="{Binding ShowsCloseQuits, Mode=OneTime}"
                                  AutomationProperties.Name="关闭窗口即退出 SCSKiller">
                            <StackPanel Spacing="2">
                                <TextBlock Text="关闭窗口即退出 SCSKiller" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding CloseQuitsNote}" Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding BeforeAfter, Mode=TwoWay}" AutomationProperties.Name="“之前/之后”录制">
                            <StackPanel Spacing="2">
                                <TextBlock Text="“之前/之后”录制" TextWrapping="Wrap" />
                                <TextBlock Text="先冷启动测量游戏，编译后再次测量，生成可分享的报告。"
                                           Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding ScanAtStart, Mode=TwoWay}" AutomationProperties.Name="SCSKiller 启动时扫描游戏">
                            <StackPanel Spacing="2">
                                <TextBlock Text="SCSKiller 启动时扫描游戏" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding ScanAtStartNote, Mode=OneTime}" Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox IsChecked="{Binding HddMode, Mode=TwoWay}" AutomationProperties.Name="HDD 模式">
                            <StackPanel Spacing="2">
                                <TextBlock Text="HDD 模式" TextWrapping="Wrap" />
                                <TextBlock Text="仅在打开或编译游戏时才读取其文件。"
                                           Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <StackPanel Spacing="2" Margin="28,0,0,0" IsVisible="{Binding ShowsHddDrives}">
                            <TextBlock Text="或仅对以下硬盘上的游戏生效：" Classes="Caption" TextWrapping="Wrap" />
                            <ItemsControl ItemsSource="{Binding HddDrives}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:HddDriveRow">
                                        <CheckBox Content="{Binding Drive}" IsChecked="{Binding On, Mode=TwoWay}" AutomationProperties.Name="{Binding Drive}" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <CheckBox IsChecked="{Binding ActiveCheck, Mode=TwoWay}" AutomationProperties.Name="每日发送匿名签到">
                            <StackPanel Spacing="2">
                                <TextBlock Text="每日发送匿名签到" TextWrapping="Wrap" />
                                <TextBlock Text="帮助我们统计活跃安装量以便配置服务器。每天一次，仅含应用版本和 GPU 厂商，不含任何标识符。"
                                           Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <CheckBox x:Name="CompactUiBox" IsChecked="{Binding CompactUi, Mode=TwoWay}" AutomationProperties.Name="紧凑界面">
                            <StackPanel Spacing="2">
                                <TextBlock Text="紧凑界面" TextWrapping="Wrap" />
                                <TextBlock Text="将游戏库摘要显示为两个窄磁贴。" Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                        </CheckBox>
                        <StackPanel>
                            <TextBlock Text="主题" Classes="Header" />
                            <ComboBox ItemsSource="{Binding Themes, Mode=OneTime}" SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" MinWidth="220"
                                      AutomationProperties.Name="主题" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Row="1" Grid.Column="1" Classes="Card" Padding="20">
                    <StackPanel Spacing="8">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <StackPanel Spacing="2">
                                <TextBlock Text="在所有兼容游戏中录制" Classes="Section" />
                                <TextBlock Text="{Binding RecordAllGamesNote, Mode=OneTime}" Classes="Caption" TextWrapping="Wrap" />
                            </StackPanel>
                            <ToggleSwitch Grid.Column="1" IsChecked="{Binding RecordAllGames, Mode=TwoWay}" AutomationProperties.Name="在所有兼容游戏中录制" />
                        </Grid>
                        <TextBlock Text="{Binding RecordingCount}" Classes="Caption" TextWrapping="Wrap" />
                        <StackPanel Spacing="4" IsVisible="{Binding ShowsRecordAntiCheatGames, Mode=OneTime}">
                            <CheckBox IsChecked="{Binding RecordAntiCheatGames, Mode=TwoWay}" AutomationProperties.Name="允许在带反作弊的游戏中使用记录器（风险自负）">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="允许在带反作弊的游戏中使用记录器（风险自负）" TextWrapping="Wrap" />
                                    <TextBlock Text="在带反作弊的游戏中启用记录器需自担风险。SCSKiller 不对封号负责。"
                                               Classes="Caption" TextWrapping="Wrap" />
                                </StackPanel>
                            </CheckBox>
                            <HyperlinkButton Content="详情" Click="OnAntiCheatDetails" Padding="0" Margin="28,0,0,0" AutomationProperties.Name="关于在带反作弊的游戏中录制的详情" />
                        </StackPanel>
                        <StackPanel Spacing="4" IsVisible="{Binding ShowsTraversal, Mode=OneTime}">
                            <Rectangle Classes="Divider" Margin="0,6" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                <TextBlock x:Name="TraversalLabel" Text="遍历卡顿修复（实验性）" VerticalAlignment="Center" TextWrapping="Wrap" />
                                <ComboBox Grid.Column="1" ItemsSource="{x:Static m:SettingsVm.TraversalChoices}" MinWidth="140"
                                          SelectedIndex="{Binding TraversalIndex, Mode=TwoWay}" AutomationProperties.LabeledBy="{Binding #TraversalLabel}" />
                            </Grid>
                            <TextBlock Text="{Binding TraversalNote}" Classes="Caption" TextWrapping="Wrap" />
                            <TextBlock Text="{Binding TraversalWarning}" IsVisible="{Binding TraversalLowVram}" Foreground="{DynamicResource WarnBrush}" Classes="Caption" TextWrapping="Wrap" />
                        </StackPanel>
                        <Rectangle Classes="Divider" Margin="0,6" />
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                            <TextBlock x:Name="RecordingLimitLabel" Text="每游戏录制上限" VerticalAlignment="Center" TextWrapping="Wrap" />
                            <ComboBox Grid.Column="1" ItemsSource="{x:Static m:SettingsVm.RecordingLimitLabels}" MinWidth="140"
                                      SelectedIndex="{Binding RecordingLimitIndex, Mode=TwoWay}" AutomationProperties.LabeledBy="{Binding #RecordingLimitLabel}" />
                        </Grid>
                        <TextBlock Text="计入游戏文件夹中的录制内容和 SCSKiller 的副本。达到上限后游戏照常运行，只是不再录制新管线。"
                                   Classes="Caption" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding RecordingSpace}" TextWrapping="Wrap" />
                        <Expander Header="各游戏占用" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" IsVisible="{Binding HasRecordings}">
                            <ItemsControl ItemsSource="{Binding Recordings}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Spacing="8" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="m:DetailRow">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                            <StackPanel Spacing="2">
                                                <TextBlock Text="{Binding Label}" TextWrapping="Wrap" />
                                                <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" Foreground="{DynamicResource WarnBrush}" Classes="Caption" TextWrapping="Wrap" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" Text="{Binding Value}" />
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>
                        <StackPanel x:Name="RemoveRecordersPart" Spacing="8">
                            <Rectangle Classes="Divider" Margin="0,6" />
                            <Grid Classes="Split" ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="12">
                                <TextBlock Text="{x:Static m:SettingsVm.RemoveRecordersNote}"
                                           Classes="Caption" TextWrapping="Wrap" VerticalAlignment="Center" />
                                <Button Classes="Side" Content="移除记录器" Click="OnRemoveRecorders" />
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
